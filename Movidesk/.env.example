PORT=5000
ALLOWED_ORIGINS=http://localhost:5000

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
# CA PEM confiável para Postgres com TLS; use \n para quebras de linha.
DB_SSL_CA=

# Obrigatória: use 32+ caracteres ASCII aleatórios; preserve a chave atual ao atualizar.
ENCRYPTION_KEY=

# ── apidatalake (bronze/silver/gold do Movidesk) ───────────────────────────
# Fase 1 da migração de tickets.js: leitura via API própria em vez da tabela
# local `tickets`. Token Bearer emitido no TOKEN_PROFILES da apidatalake —
# NUNCA reaproveitar aqui o movidesk_token (config.js) nem o token do Gateway
# Proxy/"Ponte API" (X-Gateway-Token, apimovidesk.viasoftcloud.com.br) — são
# credenciais de serviços diferentes.
DATALAKE_API_URL=https://apidatalake.viasoftcloud.com.br
DATALAKE_API_TOKEN=

# ── SSO Google (login único do painel: Movidesk + aba Jira) ───────────────
# Client ID de um OAuth Client (tipo "Web application") criado no Google
# Cloud Console. Sem isso preenchido, a tela de login mostra o botão do
# Google mas o login não funciona (erro 500 do backend).
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=viasoft.com.br

# ── Aba Jira ────────────────────────────────────────────────────────────────
# Pasta onde o jira_extractor.py grava os *_data.json (dashboard_data.json,
# tdc_data.json, abertos_data.json, fechados_data.json, sprint_data.json,
# issues_raw.json). Caminho relativo à raiz do repositório (pasta que contém
# Movidesk/ e Jira/).
JIRA_DATA_DIR=../Jira
