PORT=5000
ENABLE_SERVER_AUTOSYNC=1
ALLOWED_ORIGINS=http://localhost:5000

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Obrigatória (mínimo 32 caracteres) — sem ela o servidor não sobe.
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=
# Só pra migrar segredos gravados com uma chave antiga (ver DEPLOY.md).
LEGACY_ENCRYPTION_KEY=

# ── apidatalake (bronze/silver/gold do Movidesk) ───────────────────────────
# Fase 1 da migração de tickets.js: leitura via API própria em vez da tabela
# local `tickets`. Token Bearer emitido no TOKEN_PROFILES da apidatalake —
# NUNCA reaproveitar aqui o movidesk_token (config.js) nem o token do Gateway
# Proxy/"Ponte API" (X-Gateway-Token, apimovidesk.viasoftcloud.com.br) — são
# credenciais de serviços diferentes.
DATALAKE_API_URL=https://apidatalake.viasoftcloud.com.br
DATALAKE_API_TOKEN=

# ── SSO Google (login único do painel: Movidesk + aba Jira) ───────────────
# Client ID de um OAuth Client (tipo "Web application") criado no Google
# Cloud Console. Sem isso preenchido, a tela de login mostra o botão do
# Google mas o login não funciona (erro 500 do backend).
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=viasoft.com.br

# ── Aba Jira ────────────────────────────────────────────────────────────────
# Pasta onde o jira_extractor.py grava os *_data.json (dashboard_data.json,
# tdc_data.json, abertos_data.json, fechados_data.json, sprint_data.json,
# issues_raw.json). Caminho relativo à raiz do repositório (pasta que contém
# Movidesk/ e Jira/).
JIRA_DATA_DIR=../Jira

# ── Fotos oficiais das pessoas ─────────────────────────────────────────────
# Pasta(s) com as fotos (email_dominio.jpg), separadas por ";". No Docker,
# monte a pasta como volume e aponte pro caminho dentro do container.
PHOTOS_DIRS=

# ── Rede / segurança ───────────────────────────────────────────────────────
# Atrás de proxy reverso (Caddy/nginx) use TRUST_PROXY=1 — o limite de
# tentativas de login usa o IP do cliente.
TRUST_PROXY=
# CSP_REPORT_ONLY=1 só avisa no console as violações da Content-Security-Policy
# em vez de bloquear (pra investigar se algum recurso externo parar de carregar).
CSP_REPORT_ONLY=

# Campos customizados do serviço Analytics (Painel Geral → Chamado Listagem). Padrões já embutidos: 250810 = Data Início Implantação, 26105 = Valor do Orçamento (R$); só preencha para trocar
#CF_INICIO_IMPLANTACAO_ID=250810
#CF_VALOR_ORCAMENTO_ID=26105

# E-mail de boas-vindas ao cadastrar pessoa (SMTP do Google Workspace: crie uma "senha de app" na conta que envia).
# Sem SMTP_USER/SMTP_PASS o cadastro funciona normalmente, só não envia o e-mail.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=Hub 360 <hub360@viasoft.com.br>
#PUBLIC_URL=https://hub-360.viasoftcloud.com.br
