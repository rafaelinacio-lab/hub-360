# Dependências instaladas — nunca versionar, cada máquina roda `npm install`.
node_modules/

# Segredos e configuração local — cada ambiente tem o seu. Ver .env.example
# pra saber quais variáveis existem.
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Exports de dados reais (chamados, clientes) — não versionar em repo público.
*.xlsx

# Dados gerados pelo jira_extractor.py (agendado fora do git, escreve em Jira/) —
# são dumps reais de tarefas/pessoas, não código. O painel só lê o que já
# estiver na pasta; cada ambiente gera os seus via extrator ou task scheduler.
Jira/*_data.json
Jira/issues_raw.json

# Editor/OS
.DS_Store
Thumbs.db

# Python test/runtime cache
__pycache__/
*.pyc
Jira/*.tmp
